# Database
DATABASE_URL="postgresql://cardverse:cardverse@localhost:5432/cardverse?schema=public"

# Redis (optional)
REDIS_URL="redis://localhost:6379"

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="7d"

# Game
INITIAL_CHIPS=1000
MAX_PLAYERS=8
MIN_PLAYERS=2
BET_TIMEOUT_MS=30000
ACTION_TIMEOUT_MS=20000

# Magic Cards
MAGIC_CARDS_PER_ROUND=2
MAGIC_CARDS_INITIAL=2
MAGIC_MAX_ACTIVE_PER_ROUND=1
